{
  "openapi": "3.0.3",
  "info": {
    "title": "Tillo Rewards API",
    "version": "2.0.0",
    "description": "List Tillo brands and float balances, and issue digital gift cards."
  },
  "servers": [
    { "url": "https://app.tillo.io" }
  ],
  "security": [
    { "apiKeyAuth": [] }
  ],
  "paths": {
    "/brands": {
      "get": {
        "operationId": "listBrands",
        "summary": "List brands",
        "responses": {
          "200": {
            "description": "Brands",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Brand" }
                }
              }
            }
          }
        }
      }
    },
    "/check-floats": {
      "get": {
        "operationId": "listFloats",
        "summary": "List float balances per currency",
        "responses": {
          "200": {
            "description": "Floats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Float" }
                }
              }
            }
          }
        }
      }
    },
    "/digital/issue": {
      "post": {
        "operationId": "issueDigitalGiftCard",
        "summary": "Issue a digital gift card",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DgcInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The issued gift card order",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Dgc" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "API-Key"
      }
    },
    "schemas": {
      "Brand": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "currency": { "type": "string" }
        }
      },
      "Float": {
        "type": "object",
        "properties": {
          "currency": { "type": "string" },
          "balance": { "type": "number" }
        }
      },
      "DgcInput": {
        "type": "object",
        "required": ["client_request_id", "brand", "face_value"],
        "properties": {
          "client_request_id": { "type": "string" },
          "brand": { "type": "string" },
          "face_value": {
            "type": "object",
            "properties": {
              "amount": { "type": "number" },
              "currency": { "type": "string" }
            }
          },
          "delivery_method": { "type": "string" },
          "sector": { "type": "string" }
        }
      },
      "Dgc": {
        "type": "object",
        "properties": {
          "client_request_id": { "type": "string" },
          "brand": { "type": "string" },
          "code": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
