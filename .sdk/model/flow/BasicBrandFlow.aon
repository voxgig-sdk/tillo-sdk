        suffix: "_dt0"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-brand_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBrandFlow"
}