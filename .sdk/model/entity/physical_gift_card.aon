"float\",\"type\":\"number\"}]},\"currency\":{\"enum\":[\"AED\",\"AUD\",\"BHD\",\"BRL\",\"CAD\",\"CHF\",\"CNY\",\"CZK\",\"DKK\",\"EUR\",\"GBP\",\"HUF\",\"INR\",\"JPY\",\"KWD\",\"MXN\",\"NOK\",\"NZD\",\"OMR\",\"PLN\",\"QAR\",\"RON\",\"SAR\",\"SEK\",\"USD\"],\"maxLength\":3,\"minLength\":3,\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"}},\"required\":[\"amount\",\"currency\"],\"type\":\"object\"},\"pin\":{\"description\":\"The gift card PIN, only required for certain brands.\",\"maxLength\":20,\"minLength\":3,\"pattern\":\"^[a-zA-Z0-9_-]+$\",\"type\":\"string\"},\"reference\":{\"description\":\"Unique reference for this transaction\",\"example\":\"019ade93-d513-776b-92a2-b6323329b661\",\"format\":\"uuid\",\"type\":\"string\"}},\"required\":[\"brand\",\"client_request_id\",\"code\",\"face_value\",\"reference\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":{\"code\":\"000\",\"data\":{\"brand\":\"example-brand\",\"code\":\"6405666273630824\",\"face_value\":{\"amount\":20,\"currency\":\"GBP\"},\"fulfilled_at\":\"2025-12-17T11:32:12+00:00\",\"reference\":\"a87423c0-db3b-11f0-94a8-43a459169868\"},\"message\":\"Card fulfilled successfully\",\"status\":\"success\"},\"schema\":{\"properties\":{\"code\":{\"const\":\"000\",\"maxLength\":3,\"minLength\":3,\"type\":\"string\"},\"data\":{\"properties\":{\"brand\":{\"description\":\"Brand identifier/slug (lowercase letters, numbers, hyphens only). Must be a brand connected to your buyer account.\\n\",\"example\":\"fixed-async-uk\",\"maxLength\":255,\"minLength\":1,\"pattern\":\"^[a-z0-9-]+$\",\"type\":\"string\"},\"code\":{\"description\":\"Some brands may return this within the response where relevant.\",\"type\":\"string\"},\"expiration_date\":{\"description\":\"The expiration date for this gift card. This will only be present when the brand provides one.\",\"format\":\"date-time\",\"type\":\"string\"},\"face_value\":{\"properties\":{\"amount\":{\"examples\":[24.99,25,25.5],\"format\":\"float\",\"type\":\"number\"},\"currency\":{\"enum\":[\"AED\",\"AUD\",\"BHD\",\"BRL\",\"CAD\",\"CHF\",\"CNY\",\"CZK\",\"DKK\",\"EUR\",\"GBP\",\"HUF\",\"INR\",\"JPY\",\"KWD\",\"MXN\",\"NOK\",\"NZD\",\"OMR\",\"PLN\",\"QAR\",\"RON\",\"SAR\",\"SEK\",\"USD\"],\"maxLength\":3,\"minLength\":3,\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"}},\"required\":[\"amount\",\"currency\"],\"type\":\"object\"},\"float_balance\":{\"properties\":{\"$ref\":\"#/responses/200/content/application~1json/schema/properties/data/properties/face_value/properties\"},\"required\":{\"$ref\":\"#/responses/200/content/application~1json/schema/properties/data/properties/face_value/required\"},\"type\":\"object\"},\"fulfilled_at\":{\"description\":\"The date for which this this gift card was fulfilled.\",\"format\":\"date-time\",\"type\":\"string\"},\"reference\":{\"description\":\"Unique reference for this transaction\",\"example\":\"019ade93-d513-776b-92a2-b6323329b661\",\"format\":\"uuid\",\"type\":\"string\"},\"security_code\":{\"description\":\"Some brands may return this within the response where relevant.\",\"type\":\"string\"},\"serial_number\":{\"description\":\"Some brands may return this within the response where relevant.\",\"type\":\"string\"}},\"required\":[\"brand\",\"face_value\",\"reference\"],\"type\":\"object\"},\"message\":{\"const\":\"Card fulfilled successfully\",\"type\":\"string\"},\"status\":{\"const\":\"success\",\"type\":\"string\"}},\"required\":[\"code\",\"status\",\"message\",\"data\"],\"type\":\"object\"}}},\"description\":\"Successful Response\"},\"400\":{\"content\":{\"application/json\":{\"examples\":{\"invalid_brand\":{\"description\":\"Example error when providing an invalid brand\",\"summary\":\"Invalid brand\",\"value\":{\"code\":\"072\",\"message\":\"The requested brand [abc123] does not exist\",\"status\":\"error\"}},\"invalid_face_value\":{\"description\":\"This error can occur when not using a valid face value amount. \\nEnsure that for open denomination brands your amount is above the minimum, and below the maximum thresholds.\\nFor fixed denomination brands, ensure that the face value amount you have specified is a valid denomination. \\nUse the brands endpoint to determine what are the allowed face value amounts per brand.\\n\",\"summary\":\"Invalid face value amount\",\"value\":{\"code\":\"704\",\"message\":\"Denomination [20] not available for Brand [Example Brand]\",\"status\":\"error\"}}},\"schema\":{\"properties\":{\"code\":{\"description\":\"Internal error code (3-digit string)\",\"example\":\"434\",\"type\":\"string\"},\"data\":{\"additionalProperties\":true,\"description\":\"Optional additional error details\",\"type\":\"object\"},\"message\":{\"description\":\"Human-readable error message\",\"example\":\"Authentication failed\",\"type\":\"string\"},\"status\":{\"const\":\"error\",\"description\":\"Status of the response\",\"type\":\"string\"}},\"required\":[\"code\",\"status\",\"message\"],\"type\":\"object\"}}},\"description\":\"Bad Request\"},\"401\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"description\":\"Internal error code (3-digit string)\",\"example\":\"434\",\"type\":\"string\"},\"message\":{\"description\":\"Human-readable error message\",\"example\":\"Authentication failed\",\"type\":\"string\"},\"status\":{\"const\":\"error\",\"description\":\"Status of the response\",\"type\":\"string\"}},\"required\":[\"code\",\"status\",\"message\"],\"type\":\"object\"}}},\"description\":\"Authentication failed. Invalid API key, signature, or timestamp.\"},\"422\":{\"content\":{\"application/json\":{\"examples\":{\"invalid_status\":{\"description\":\"This error can occur when the sale your trying to fulfil is not currently in the correct status\",\"summary\":\"Invalid sale status\",\"value\":{\"code\":\"433\",\"data\":{\"reference\":\"Cannot fulfil order, invalid status\"},\"message\":\"There were errors validating the request\",\"status\":\"error\"}}},\"